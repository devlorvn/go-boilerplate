APP_NAME=fileservice
APP_ENV=local
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_DB_NAME=file_db

GRPC_PORT=50052
GRPC_TIMEOUT=10s

# Must match .env.auth
AUTH_JWT_SECRET=change-me

PROVIDER_AWS_REGION=ap-southeast-1
PROVIDER_AWS_ACCESS_KEY_ID=mock_access_key
PROVIDER_AWS_SECRET_ACCESS_KEY=mock_secret_key
PROVIDER_AWS_ENDPOINT=
PROVIDER_AWS_BUCKET=my-app-bucket

METRICS_ENABLED=true
METRICS_PORT=2113
