# APP & LOG
APP_NAME=gateway
APP_ENV=local
LOG_LEVEL=debug

# HTTP & GATEWAY
HTTP_PORT=8000
HTTP_AUTH_SVC_ADDR=localhost:50051
HTTP_FILE_SVC_ADDR=localhost:50052

# gRPC SERVER
GRPC_PORT=50051
GRPC_TIMEOUT=10s

# DATABASE (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DB_NAME=auth_db
DB_AUTH_DB_NAME=auth_db
DB_FILE_DB_NAME=file_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# KAFKA
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=go-boilerplate-group

# AWS S3 / PROVIDER (FILE SERVICE)
PROVIDER_AWS_REGION=ap-southeast-1
PROVIDER_AWS_ACCESS_KEY_ID=mock_access_key
PROVIDER_AWS_SECRET_ACCESS_KEY=mock_secret_key

# AUTH
AUTH_JWT_SECRET=supersecretkey123

# PROMETHEUS METRICS
METRICS_ENABLED=true
METRICS_PORT=2112
