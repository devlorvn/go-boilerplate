APP_NAME=authservice
APP_ENV=local
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_DB_NAME=auth_db

GRPC_PORT=50051
GRPC_TIMEOUT=10s

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=go-boilerplate-group

# Must be identical in every service that verifies tokens. Generate: openssl rand -hex 32
AUTH_JWT_SECRET=change-me

METRICS_ENABLED=true
METRICS_PORT=2112
